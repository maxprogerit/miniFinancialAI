# OpenAI API credentials
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=30.0

# Used by the app (psycopg connection string) - host/port must match docker-compose.yml
DATABASE_URL=postgresql://postgres:changeme@localhost:5434/financialdb

# Used by docker-compose.yml to set the Postgres container's password
# (must match the password embedded in DATABASE_URL above)
POSTGRES_PASSWORD=changeme

# Secret used to sign JWT access tokens - generate your own, e.g.:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-64-char-hex-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
RAG_TOP_K=3
CHAT_RATE_LIMIT_PER_MINUTE=20

# Optional - only set these if you can verify current real pricing for
# OPENAI_MODEL. Leaving them unset is deliberate: the app will never guess
# a $ figure, UsageInfo.cost_usd just stays null instead.
# OPENAI_INPUT_PRICE_PER_MILLION=2.50
# OPENAI_OUTPUT_PRICE_PER_MILLION=10.00
